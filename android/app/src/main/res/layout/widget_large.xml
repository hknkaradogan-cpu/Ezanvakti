<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_logo" android:contentDescription="@string/app_name" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:id="@+id/w_city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İstanbul"
                android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/w_date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=""
                android:textColor="#F0D27A" android:textSize="11sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextView android:id="@+id/w_next" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Öğle"
                android:textColor="#F0D27A" android:textSize="12sp" android:maxLines="1" />
            <Chronometer android:id="@+id/w_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="24sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/r_imsak" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n_imsak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İmsak"
                android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t_imsak" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r_sunrise" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Güneş"
                android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t_sunrise" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r_dhuhr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Öğle"
                android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t_dhuhr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r_asr" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="İkindi"
                android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t_asr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r_maghrib" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Akşam"
                android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t_maghrib" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:id="@+id/r_isha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/n_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Yatsı"
                android:textColor="#D9FFFFFF" android:textSize="11sp" android:maxLines="1" />
            <TextView android:id="@+id/t_isha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--:--"
                android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
