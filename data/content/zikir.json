[{"ar":"سُبْحَانَ اللَّهِ","okunus":"Sübhânallâh","tr":"Allah her türlü noksanlıktan uzaktır.","en":"Glory be to Allah.","count":33,"src":"Müslim, Mesâcid 146"},{"ar":"الْحَمْدُ لِلَّهِ","okunus":"Elhamdülillâh","tr":"Hamd Allah'a mahsustur.","en":"Praise be to Allah.","count":33,"src":"Müslim, Mesâcid 146"},{"ar":"اللَّهُ أَكْبَرُ","okunus":"Allâhü ekber","tr":"Allah en büyüktür.","en":"Allah is the Greatest.","count":33,"src":"Müslim, Mesâcid 146"},{"ar":"لَا إِلَٰهَ إِلَّا اللَّهُ","okunus":"Lâ ilâhe illallâh","tr":"Allah'tan başka ilah yoktur.","en":"There is no god but Allah.","count":100,"src":"Tirmizî, Deavât 9"},{"ar":"أَسْتَغْفِرُ اللَّهَ","okunus":"Estağfirullâh","tr":"Allah'tan bağışlanma dilerim.","en":"I seek Allah's forgiveness.","count":100,"src":"Müslim, Zikir 41"},{"ar":"سُبْحَانَ اللَّهِ وَبِحَمْدِهِ","okunus":"Sübhânallâhi ve bi-hamdih","tr":"Allah'ı hamd ile tesbih ederim.","en":"Glory be to Allah and praise be to Him.","count":100,"src":"Buhârî, Deavât 65; Müslim, Zikir 28"},{"ar":"لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ","okunus":"Lâ havle ve lâ kuvvete illâ billâh","tr":"Güç ve kuvvet ancak Allah'ın yardımıyladır.","en":"There is no power and no strength except with Allah.","count":33,"src":"Buhârî, Deavât 51; Müslim, Zikir 44"},{"ar":"اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ","okunus":"Allâhümme salli alâ Muhammed","tr":"Allah'ım! Muhammed'e salât eyle.","en":"O Allah, send blessings upon Muhammad.","count":100,"src":"Müslim, Salât 70"},{"ar":"حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ","okunus":"Hasbünallâhü ve ni'me'l-vekîl","tr":"Allah bize yeter, O ne güzel vekildir.","en":"Allah is sufficient for us, and He is the best Disposer of affairs.","count":33,"src":"Âl-i İmrân 3:173"}]