[{"n":1,"ar":"الرَّحْمَٰنُ","okunus":"Er-Rahmân","tr":"Dünyada bütün yaratıklara merhamet eden, rahmeti her şeyi kuşatan.","en":"The Most Compassionate, whose mercy encompasses all creation."},{"n":2,"ar":"الرَّحِيمُ","okunus":"Er-Rahîm","tr":"Ahirette müminlere özel olarak merhamet eden.","en":"The Most Merciful, especially to the believers in the Hereafter."},{"n":3,"ar":"الْمَلِكُ","okunus":"El-Melik","tr":"Mülkün ve kâinatın gerçek sahibi, mutlak hükümdar.","en":"The King, the true Owner of all dominion."},{"n":4,"ar":"الْقُدُّوسُ","okunus":"El-Kuddûs","tr":"Her türlü eksiklik ve kusurdan uzak, tertemiz.","en":"The Most Holy, free from every imperfection."},{"n":5,"ar":"السَّلَامُ","okunus":"Es-Selâm","tr":"Esenlik veren, kullarını tehlikelerden selamete çıkaran.","en":"The Source of Peace and safety."},{"n":6,"ar":"الْمُؤْمِنُ","okunus":"El-Mü'min","tr":"Güven veren, kalplere iman nuru yerleştiren.","en":"The Granter of security and faith."},{"n":7,"ar":"الْمُهَيْمِنُ","okunus":"El-Müheymin","tr":"Her şeyi görüp gözeten ve koruyan.","en":"The Guardian who watches over all."},{"n":8,"ar":"الْعَزِيزُ","okunus":"El-Azîz","tr":"İzzet sahibi, karşı konulamaz galip.","en":"The Almighty, the Invincible."},{"n":9,"ar":"الْجَبَّارُ","okunus":"El-Cebbâr","tr":"Dilediğini yaptırmaya gücü yeten; kırık kalpleri onaran.","en":"The Compeller, who also mends what is broken."},{"n":10,"ar":"الْمُتَكَبِّرُ","okunus":"El-Mütekebbir","tr":"Büyüklükte eşi benzeri olmayan.","en":"The Supreme in greatness."},{"n":11,"ar":"الْخَالِقُ","okunus":"El-Hâlık","tr":"Her şeyi yoktan var eden, yaratan.","en":"The Creator."},{"n":12,"ar":"الْبَارِئُ","okunus":"El-Bâri'","tr":"Her şeyi birbiriyle uyumlu ve kusursuz yaratan.","en":"The Maker who creates in perfect harmony."},{"n":13,"ar":"الْمُصَوِّرُ","okunus":"El-Musavvir","tr":"Her varlığa kendine özgü şekil veren.","en":"The Fashioner of forms."},{"n":14,"ar":"الْغَفَّارُ","okunus":"El-Gaffâr","tr":"Günahları çokça örten ve bağışlayan.","en":"The Ever-Forgiving."},{"n":15,"ar":"الْقَهَّارُ","okunus":"El-Kahhâr","tr":"Her şeye galip gelen, her şeyi hükmü altında tutan.","en":"The Subduer over all."},{"n":16,"ar":"الْوَهَّابُ","okunus":"El-Vehhâb","tr":"Karşılıksız olarak bol bol veren.","en":"The Bestower of gifts without return."},{"n":17,"ar":"الرَّزَّاقُ","okunus":"Er-Rezzâk","tr":"Bütün canlıların rızkını veren.","en":"The Provider of sustenance."},{"n":18,"ar":"الْفَتَّاحُ","okunus":"El-Fettâh","tr":"Hayır kapılarını açan, kullar arasında hakla hükmeden.","en":"The Opener and Judge."},{"n":19,"ar":"الْعَلِيمُ","okunus":"El-Alîm","tr":"Gizli açık her şeyi bilen.","en":"The All-Knowing."},{"n":20,"ar":"الْقَابِضُ","okunus":"El-Kâbıd","tr":"Dilediğine rızkı daraltan, ruhları kabzeden.","en":"The Withholder."},{"n":21,"ar":"الْبَاسِطُ","okunus":"El-Bâsıt","tr":"Dilediğine rızkı genişleten, ruhlara hayat veren.","en":"The Expander."},{"n":22,"ar":"الْخَافِضُ","okunus":"El-Hâfıd","tr":"Dilediğini alçaltan.","en":"The Abaser."},{"n":23,"ar":"الرَّافِعُ","okunus":"Er-Râfi'","tr":"Dilediğini yükselten.","en":"The Exalter."},{"n":24,"ar":"الْمُعِزُّ","okunus":"El-Muiz","tr":"Dilediğine izzet ve şeref veren.","en":"The Giver of honour."},{"n":25,"ar":"الْمُذِلُّ","okunus":"El-Müzil","tr":"Dilediğini zillete düşüren.","en":"The Giver of dishonour."},{"n":26,"ar":"السَّمِيعُ","okunus":"Es-Semî'","tr":"Her şeyi işiten.","en":"The All-Hearing."},{"n":27,"ar":"الْبَصِيرُ","okunus":"El-Basîr","tr":"Her şeyi gören.","en":"The All-Seeing."},{"n":28,"ar":"الْحَكَمُ","okunus":"El-Hakem","tr":"Mutlak hüküm sahibi, hakkı yerine getiren.","en":"The Judge."},{"n":29,"ar":"الْعَدْلُ","okunus":"El-Adl","tr":"Mutlak adalet sahibi.","en":"The Utterly Just."},{"n":30,"ar":"اللَّطِيفُ","okunus":"El-Latîf","tr":"Lütfu bol, en ince işleri bilen.","en":"The Subtle, the Kind."},{"n":31,"ar":"الْخَبِيرُ","okunus":"El-Habîr","tr":"Her şeyin iç yüzünden haberdar olan.","en":"The All-Aware."},{"n":32,"ar":"الْحَلِيمُ","okunus":"El-Halîm","tr":"Cezalandırmakta acele etmeyen, yumuşak davranan.","en":"The Forbearing."},{"n":33,"ar":"الْعَظِيمُ","okunus":"El-Azîm","tr":"Büyüklüğü akılla kavranamayacak kadar yüce.","en":"The Magnificent."},{"n":34,"ar":"الْغَفُورُ","okunus":"El-Gafûr","tr":"Bağışlaması bol olan.","en":"The All-Forgiving."},{"n":35,"ar":"الشَّكُورُ","okunus":"Eş-Şekûr","tr":"Az amele çok mükâfat veren.","en":"The Appreciative, who rewards abundantly."},{"n":36,"ar":"الْعَلِيُّ","okunus":"El-Aliyy","tr":"Yüceler yücesi.","en":"The Most High."},{"n":37,"ar":"الْكَبِيرُ","okunus":"El-Kebîr","tr":"Büyüklükte sınırı olmayan.","en":"The Most Great."},{"n":38,"ar":"الْحَفِيظُ","okunus":"El-Hafîz","tr":"Her şeyi koruyan ve muhafaza eden.","en":"The Preserver."},{"n":39,"ar":"الْمُقِيتُ","okunus":"El-Mukît","tr":"Her yaratılmışın gıdasını veren ve gözeten.","en":"The Nourisher."},{"n":40,"ar":"الْحَسِيبُ","okunus":"El-Hasîb","tr":"Kullarını hesaba çeken, onlara kâfi gelen.","en":"The Reckoner, the Sufficient."},{"n":41,"ar":"الْجَلِيلُ","okunus":"El-Celîl","tr":"Celal ve azamet sahibi.","en":"The Majestic."},{"n":42,"ar":"الْكَرِيمُ","okunus":"El-Kerîm","tr":"Cömert, ikramı bol olan.","en":"The Generous."},{"n":43,"ar":"الرَّقِيبُ","okunus":"Er-Rakîb","tr":"Her şeyi gözetim ve kontrolü altında tutan.","en":"The Watchful."},{"n":44,"ar":"الْمُجِيبُ","okunus":"El-Mücîb","tr":"Duaları kabul eden.","en":"The Responsive, who answers prayers."},{"n":45,"ar":"الْوَاسِعُ","okunus":"El-Vâsi'","tr":"Rahmeti, ilmi ve kudreti her şeyi kuşatan.","en":"The All-Encompassing."},{"n":46,"ar":"الْحَكِيمُ","okunus":"El-Hakîm","tr":"Her işi ve emri hikmetli olan.","en":"The All-Wise."},{"n":47,"ar":"الْوَدُودُ","okunus":"El-Vedûd","tr":"Kullarını seven ve sevilmeye en layık olan.","en":"The Loving."},{"n":48,"ar":"الْمَجِيدُ","okunus":"El-Mecîd","tr":"Şanı yüce, şerefi büyük olan.","en":"The Glorious."},{"n":49,"ar":"الْبَاعِثُ","okunus":"El-Bâis","tr":"Ölüleri dirilten, peygamber gönderen.","en":"The Resurrector."},{"n":50,"ar":"الشَّهِيدُ","okunus":"Eş-Şehîd","tr":"Her şeye şahit olan.","en":"The Witness."},{"n":51,"ar":"الْحَقُّ","okunus":"El-Hakk","tr":"Varlığı hiç değişmeyen gerçek.","en":"The Truth."},{"n":52,"ar":"الْوَكِيلُ","okunus":"El-Vekîl","tr":"Kendisine güvenilen, işleri en güzel şekilde yoluna koyan.","en":"The Trustee."},{"n":53,"ar":"الْقَوِيُّ","okunus":"El-Kaviyy","tr":"Her şeye gücü yeten, kudretli.","en":"The All-Strong."},{"n":54,"ar":"الْمَتِينُ","okunus":"El-Metîn","tr":"Kuvveti sarsılmaz, çok sağlam.","en":"The Firm."},{"n":55,"ar":"الْوَلِيُّ","okunus":"El-Veliyy","tr":"Müminlerin dostu ve yardımcısı.","en":"The Protecting Friend."},{"n":56,"ar":"الْحَمِيدُ","okunus":"El-Hamîd","tr":"Her türlü övgüye layık olan.","en":"The Praiseworthy."},{"n":57,"ar":"الْمُحْصِي","okunus":"El-Muhsî","tr":"Her şeyin sayısını tek tek bilen.","en":"The Accounter of all things."},{"n":58,"ar":"الْمُبْدِئُ","okunus":"El-Mübdi'","tr":"Her şeyi ilk defa yaratan.","en":"The Originator."},{"n":59,"ar":"الْمُعِيدُ","okunus":"El-Muîd","tr":"Yaratılmışları yeniden diriltecek olan.","en":"The Restorer."},{"n":60,"ar":"الْمُحْيِي","okunus":"El-Muhyî","tr":"Hayat veren.","en":"The Giver of life."},{"n":61,"ar":"الْمُمِيتُ","okunus":"El-Mümît","tr":"Ölümü yaratan.","en":"The Creator of death."},{"n":62,"ar":"الْحَيُّ","okunus":"El-Hayy","tr":"Ezelî ve ebedî hayat sahibi, diri.","en":"The Ever-Living."},{"n":63,"ar":"الْقَيُّومُ","okunus":"El-Kayyûm","tr":"Her şeyi ayakta tutan, varlıkları idare eden.","en":"The Self-Subsisting Sustainer."},{"n":64,"ar":"الْوَاجِدُ","okunus":"El-Vâcid","tr":"İstediğini bulan, hiçbir şeye muhtaç olmayan.","en":"The Finder, lacking nothing."},{"n":65,"ar":"الْمَاجِدُ","okunus":"El-Mâcid","tr":"Şanı büyük, keremi bol olan.","en":"The Illustrious."},{"n":66,"ar":"الْوَاحِدُ","okunus":"El-Vâhid","tr":"Zatında, sıfatlarında ve fiillerinde tek.","en":"The One."},{"n":67,"ar":"الْأَحَدُ","okunus":"El-Ehad","tr":"Zatında, sıfatlarında ve fiillerinde bir olan, eşi ve benzeri bulunmayan.","en":"The Unique, the Only One."},{"n":68,"ar":"الصَّمَدُ","okunus":"Es-Samed","tr":"Hiçbir şeye muhtaç olmayan, her şeyin kendisine muhtaç olduğu.","en":"The Eternal Refuge."},{"n":69,"ar":"الْقَادِرُ","okunus":"El-Kâdir","tr":"Dilediğini yapmaya gücü yeten.","en":"The Able."},{"n":70,"ar":"الْمُقْتَدِرُ","okunus":"El-Muktedir","tr":"Her şeyi dilediği gibi yöneten, kudret sahibi.","en":"The All-Powerful Determiner."},{"n":71,"ar":"الْمُقَدِّمُ","okunus":"El-Mukaddim","tr":"Dilediğini öne alan.","en":"The Expediter."},{"n":72,"ar":"الْمُؤَخِّرُ","okunus":"El-Muahhir","tr":"Dilediğini geriye bırakan.","en":"The Delayer."},{"n":73,"ar":"الْأَوَّلُ","okunus":"El-Evvel","tr":"Varlığının başlangıcı olmayan.","en":"The First."},{"n":74,"ar":"الْآخِرُ","okunus":"El-Âhir","tr":"Varlığının sonu olmayan.","en":"The Last."},{"n":75,"ar":"الظَّاهِرُ","okunus":"Ez-Zâhir","tr":"Varlığı eserleriyle apaçık olan.","en":"The Manifest."},{"n":76,"ar":"الْبَاطِنُ","okunus":"El-Bâtın","tr":"Zatının mahiyeti akıllardan gizli olan.","en":"The Hidden."},{"n":77,"ar":"الْوَالِي","okunus":"El-Vâlî","tr":"Bütün kâinatı yöneten.","en":"The Governor."},{"n":78,"ar":"الْمُتَعَالِي","okunus":"El-Müteâlî","tr":"Yaratılmışların sıfatlarından münezzeh, yüce.","en":"The Most Exalted."},{"n":79,"ar":"الْبَرُّ","okunus":"El-Berr","tr":"İyiliği ve ihsanı bol olan.","en":"The Source of goodness."},{"n":80,"ar":"التَّوَّابُ","okunus":"Et-Tevvâb","tr":"Tövbeleri çokça kabul eden.","en":"The Acceptor of repentance."},{"n":81,"ar":"الْمُنْتَقِمُ","okunus":"El-Müntekım","tr":"Suçluları hak ettikleri şekilde cezalandıran.","en":"The Avenger."},{"n":82,"ar":"الْعَفُوُّ","okunus":"El-Afüvv","tr":"Affı çok olan, günahları silen.","en":"The Pardoner."},{"n":83,"ar":"الرَّءُوفُ","okunus":"Er-Raûf","tr":"Çok şefkatli ve merhametli.","en":"The Most Kind."},{"n":84,"ar":"مَالِكُ الْمُلْكِ","okunus":"Mâlikü'l-Mülk","tr":"Mülkün ebedî sahibi.","en":"The Owner of all sovereignty."},{"n":85,"ar":"ذُو الْجَلَالِ وَالْإِكْرَامِ","okunus":"Zü'l-Celâli ve'l-İkrâm","tr":"Celal (azamet) ve ikram (cömertlik) sahibi.","en":"The Lord of Majesty and Generosity."},{"n":86,"ar":"الْمُقْسِطُ","okunus":"El-Muksit","tr":"Her işi adaletle yapan.","en":"The Equitable."},{"n":87,"ar":"الْجَامِعُ","okunus":"El-Câmi'","tr":"Dilediğini dilediği yer ve zamanda toplayan.","en":"The Gatherer."},{"n":88,"ar":"الْغَنِيُّ","okunus":"El-Ganiyy","tr":"Hiçbir şeye muhtaç olmayan, zengin.","en":"The Self-Sufficient."},{"n":89,"ar":"الْمُغْنِي","okunus":"El-Muğnî","tr":"Dilediğini zenginleştiren.","en":"The Enricher."},{"n":90,"ar":"الْمَانِعُ","okunus":"El-Mâni'","tr":"Dilemediği şeye engel olan.","en":"The Preventer."},{"n":91,"ar":"الضَّارُّ","okunus":"Ed-Dârr","tr":"Elem ve zarar veren şeyleri yaratan.","en":"The Creator of harm (as a test)."},{"n":92,"ar":"النَّافِعُ","okunus":"En-Nâfi'","tr":"Fayda veren şeyleri yaratan.","en":"The Creator of benefit."},{"n":93,"ar":"النُّورُ","okunus":"En-Nûr","tr":"Göklerin ve yerin nuru, nurlandıran.","en":"The Light."},{"n":94,"ar":"الْهَادِي","okunus":"El-Hâdî","tr":"Hidayet veren, doğru yolu gösteren.","en":"The Guide."},{"n":95,"ar":"الْبَدِيعُ","okunus":"El-Bedî'","tr":"Örneksiz ve eşsiz yaratan.","en":"The Incomparable Originator."},{"n":96,"ar":"الْبَاقِي","okunus":"El-Bâkî","tr":"Varlığı sonsuz olan.","en":"The Everlasting."},{"n":97,"ar":"الْوَارِثُ","okunus":"El-Vâris","tr":"Her şey yok olduktan sonra kalan, gerçek mirasçı.","en":"The Inheritor."},{"n":98,"ar":"الرَّشِيدُ","okunus":"Er-Reşîd","tr":"Doğru yolu gösteren, her işi isabetli olan.","en":"The Guide to the right path."},{"n":99,"ar":"الصَّبُورُ","okunus":"Es-Sabûr","tr":"Çok sabırlı olan, cezada acele etmeyen.","en":"The Most Patient."}]